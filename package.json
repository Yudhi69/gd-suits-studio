{
  "name": "gd-suits-studio",
  "productName": "GD Suits Studio",
  "version": "0.1.0",
  "description": "Offline-first suit consultation, capture and AI preview tool for GD Suits.",
  "main": "electron/main.js",
  "author": "GD Suits",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "npm run build:preload && wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "npm run build:preload && vite build",
    "start": "npm run build && electron .",
    "postinstall": "electron-builder install-app-deps && npm run build:preload",
    "dist:mac": "npm run build && electron-builder --mac --arm64 && electron-builder --mac --x64 && electron-builder install-app-deps",
    "dist:win": "npm run build && electron-builder --win --x64 && electron-builder install-app-deps",
    "dist:all": "npm run dist:mac && npm run dist:win",
    "test:render": "cross-env DATA_DIR=.testdata/render electron scripts/test-render-pipeline.js",
    "test:tour": "cross-env DATA_DIR=.testdata/tour SHOT_DIR=.testdata/shots electron scripts/screenshot-tour.js",
    "test:security": "cross-env DATA_DIR=.testdata/security electron scripts/test-security.js",
    "test": "npm run test:migrations && npm run test:secrets && npm run test:security && npm run test:branding && npm run test:models && npm run test:updates && npm run test:catalog && npm run test:clientorder && npm run test:garment && npm run test:party && npm run test:persistence && npm run test:documents && npm run test:workflow && npm run test:client && npm run test:quote && npm run test:operations && npm run test:import && npm run test:render",
    "test:updates": "cross-env DATA_DIR=.testdata/updates electron scripts/test-updates.js",
    "test:catalog": "cross-env DATA_DIR=.testdata/catalog electron scripts/test-catalog.js",
    "test:workflow": "cross-env DATA_DIR=.testdata/workflow electron scripts/test-workflow.js",
    "build:preload": "esbuild electron/preload.js --bundle --platform=node --format=cjs --external:electron --outfile=electron/preload.build.js --log-level=warning",
    "test:models": "cross-env DATA_DIR=.testdata/models electron scripts/test-models.js",
    "test:client": "cross-env DATA_DIR=.testdata/client electron scripts/test-clientnotes.js",
    "test:quote": "cross-env DATA_DIR=.testdata/quote electron scripts/test-quote.js",
    "test:migrations": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-migrations.js",
    "test:operations": "cross-env DATA_DIR=.testdata/ops electron scripts/test-operations.js",
    "test:import": "electron scripts/test-import.js",
    "import:workbook": "electron scripts/import-workbook.js",
    "test:secrets": "electron scripts/test-secrets.js",
    "test:branding": "cross-env DATA_DIR=.testdata/branding electron scripts/test-branding.js",
    "make:marks": "electron scripts/make-marks.js",
    "test:clientorder": "cross-env DATA_DIR=.testdata/clientorder electron scripts/test-client-order.js",
    "test:garment": "cross-env DATA_DIR=.testdata/garment electron scripts/test-garment.js",
    "test:party": "cross-env DATA_DIR=.testdata/party electron scripts/test-party.js",
    "test:persistence": "cross-env DATA_DIR=.testdata/persistence electron scripts/test-persistence.js",
    "test:documents": "cross-env DATA_DIR=.testdata/documents electron scripts/test-documents.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "better-sqlite3": "^12.2.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.11",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "za.co.gdsuits.studio",
    "productName": "GD Suits Studio",
    "copyright": "GD Suits",
    "afterPack": "build/afterPack.js",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.tmp.js"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "darkModeSupport": false,
      "extendInfo": {
        "NSCameraUsageDescription": "GD Suits Studio uses the camera to photograph clients, fabric swatches and fittings.",
        "NSMicrophoneUsageDescription": "Not used by GD Suits Studio."
      },
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "${productName} ${arch}",
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "GD Suits Studio"
    }
  }
}
